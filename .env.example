# Copy this file to .env and fill in your values

# Your bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# The group/supergroup chat ID where the bot operates
# To get it: add @userinfobot to your group, it will show the group ID
GROUP_CHAT_ID=-100xxxxxxxxxx

# Comma-separated list of channel usernames (without @) that users must join
# Example: mychannel1,mychannel2,mychannel3
REQUIRED_CHANNELS=channel1,channel2

# Welcome message shown to new users (supports HTML formatting)
# Available placeholders: {first_name}, {username}, {group_name}
WELCOME_MESSAGE=👋 Welcome, <b>{first_name}</b>!\n\nTo start chatting in <b>{group_name}</b>:\n\n1️⃣ Join our required channels (listed below)\n2️⃣ Click <b>Verify Me ✅</b> to confirm\n\nUntil verified, your messages will be removed and you'll be reminded to verify.

# Message shown after successful verification
VERIFIED_MESSAGE=🎉 Welcome aboard, <b>{first_name}</b>! You're now verified and can chat freely. Enjoy the community!
